{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIED SYSTEM V5",
  "version": "0.4.0",
  "identifier": "br.sied.systemv5",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "SIED SYSTEM V5",
      "width": 1320,
      "height": 880,
      "minWidth": 750,
      "minHeight": 620,
      "center": true,
      "backgroundColor": "#080A10"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
